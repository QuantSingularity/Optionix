# Backend API Configuration
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30000

# Application Configuration
APP_NAME=Optionix Mobile
APP_VERSION=1.0.0

# Feature Flags
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_LOGGING=false

# WalletConnect (required for the Wallet screen)
# Get a free project ID at https://cloud.reown.com (formerly WalletConnect
# Cloud). Without it, wallet connection will fail with a clear error - the
# rest of the app works fine without one.
WALLETCONNECT_PROJECT_ID=
