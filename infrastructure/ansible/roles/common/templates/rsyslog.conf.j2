# Rsyslog Configuration for Centralized Security Logging
# Generated by Ansible - DO NOT EDIT MANUALLY

#################
#### MODULES ####
#################

module(load="imuxsock")  # local system logging (/dev/log)
module(load="imklog")    # kernel logging
module(load="imjournal" StateFile="imjournal.state")

###########################
#### GLOBAL DIRECTIVES ####
###########################

$ActionFileDefaultTemplate RSYSLOG_TraditionalFileFormat
$RepeatedMsgReduction on
$FileOwner root
$FileGroup adm
$FileCreateMode 0640
$DirCreateMode 0755
$Umask 0022
$PrivDropToUser syslog
$PrivDropToGroup syslog
$WorkDirectory /var/spool/rsyslog

###############
#### RULES ####
###############

auth,authpriv.*                /var/log/auth.log
*.*;auth,authpriv.none         -/var/log/syslog
cron.*                         /var/log/cron.log
daemon.*                       -/var/log/daemon.log
kern.*                         -/var/log/kern.log
mail.*                         -/var/log/mail.log
user.*                         -/var/log/user.log

# Security-relevant facilities kept in their own file for audit review
local0.*                       /var/log/optionix/security.log

# Emergency messages go to everyone currently logged in
*.emerg                        :omusrmsg:*

# Send a copy of everything to a local application log directory that
# security_monitor.sh / backup_recovery.sh already expect to exist
$CreateDirs on
*.* /var/log/optionix/syslog-all.log

# Include any additional per-application config snippets
$IncludeConfig /etc/rsyslog.d/*.conf
