# ModSecurity Web Application Firewall Configuration - Financial Grade
# Generated by Ansible - DO NOT EDIT MANUALLY

# Enable the rules engine (DetectionOnly would log without blocking -
# for a financial application, blocking is required, not optional).
SecRuleEngine On

# Allow ModSecurity to inspect the request body (needed for JSON API
# payloads, which this application uses throughout).
SecRequestBodyAccess On
SecRequestBodyLimit 13107200
SecRequestBodyNoFilesLimit 131072
SecRequestBodyInMemoryLimit 131072
SecRequestBodyLimitAction Reject

# Response body inspection - useful for catching data leakage, but
# capped low to avoid excessive memory use on large API responses.
SecResponseBodyAccess On
SecResponseBodyLimit 1048576
SecResponseBodyLimitAction ProcessPartial

# Temp/upload directories
SecTmpDir /tmp/
SecDataDir /tmp/
SecUploadDir /tmp/

# Audit logging - full audit trail of relevant transactions, consistent
# with the audit-heavy compliance posture of the rest of this platform.
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial
SecAuditLog /var/log/nginx/modsec_audit.log

# Default action if a rule matches: log and block with a 403
SecDefaultAction "phase:1,log,auditlog,deny,status:403"

# Load the OWASP Core Rule Set (installed via the modsecurity-crs package)
IncludeOptional /usr/share/modsecurity-crs/crs-setup.conf
IncludeOptional /usr/share/modsecurity-crs/rules/*.conf

# Unicode mapping required by the CRS
SecUnicodeMapFile unicode.mapping 20127
