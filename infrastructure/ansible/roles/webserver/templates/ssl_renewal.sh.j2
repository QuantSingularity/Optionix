#!/bin/bash
# SSL Certificate Renewal Script - Financial Grade
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Runs monthly via cron (see roles/webserver/tasks/main.yml). certbot
# itself refuses to renew certificates that aren't yet within their
# renewal window, so running this monthly is safe even though
# certificates are typically only renewed every ~60 days.

set -uo pipefail
# Not using `set -e`: a renewal failure must still fall through to the
# alert/log step below rather than silently aborting.

LOG_FILE="/var/log/optionix/ssl_renewal.log"
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

log "Starting certificate renewal check"

if certbot renew --quiet --deploy-hook "systemctl reload nginx" >> "$LOG_FILE" 2>&1; then
    log "Certificate renewal check completed successfully"
else
    log "ERROR: certbot renew failed - certificates may be approaching expiry"
    exit 1
fi

# Warn early if any certificate is unexpectedly close to expiry despite
# the renewal above (e.g. renewal silently skipped for some domain).
for cert_dir in /etc/letsencrypt/live/*/; do
    [ -d "$cert_dir" ] || continue
    cert_file="${cert_dir}fullchain.pem"
    [ -f "$cert_file" ] || continue

    expiry_epoch=$(openssl x509 -in "$cert_file" -noout -enddate 2>/dev/null | cut -d= -f2 | xargs -I{} date -d {} +%s 2>/dev/null || echo "")
    if [ -n "$expiry_epoch" ]; then
        now_epoch=$(date +%s)
        days_left=$(( (expiry_epoch - now_epoch) / 86400 ))
        if [ "$days_left" -lt 14 ]; then
            log "WARNING: certificate in $cert_dir expires in $days_left days"
        fi
    fi
done
