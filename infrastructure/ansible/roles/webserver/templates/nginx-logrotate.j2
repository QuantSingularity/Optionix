# Logrotate Configuration for Nginx Logs - Financial Compliance
# Generated by Ansible - DO NOT EDIT MANUALLY

/var/log/nginx/*.log {
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -f /run/nginx.pid ]; then
            kill -USR1 "$(cat /run/nginx.pid)"
        fi
    endscript
}

/var/log/nginx/modsec_audit.log {
    daily
    rotate 365
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
}
