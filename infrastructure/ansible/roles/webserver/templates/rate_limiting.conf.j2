# Rate Limiting & Abuse Protection - Financial Grade
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# The limit_req_zone/limit_conn_zone definitions themselves live in
# nginx.conf.j2 (http{} block), and are applied per-location in
# optionix.conf.j2. This file adds complementary, connection-level
# protections that aren't request-rate-based.

# Mitigate slow-loris style attacks by bounding how long a client may
# take to send its request.
client_body_timeout 10s;
client_header_timeout 10s;
send_timeout 10s;

# Reject requests using HTTP methods this API never needs.
map $request_method $blocked_method {
    default 0;
    TRACE   1;
    TRACK   1;
    CONNECT 1;
}

# Block a common set of vulnerability-scanner user agents.
map $http_user_agent $blocked_agent {
    default 0;
    ~*(nikto|sqlmap|nmap|masscan|nessus|acunetix|w3af) 1;
}
