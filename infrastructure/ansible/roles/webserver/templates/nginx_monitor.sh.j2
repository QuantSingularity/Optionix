#!/bin/bash
# Nginx Health Monitoring Script - Financial Grade
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Runs every 5 minutes via cron (see roles/webserver/tasks/main.yml).
# Restarts nginx automatically if it's down, and logs the event for
# security_monitor.sh to pick up (it already watches
# /var/log/optionix/*.log for anomalies).

set -uo pipefail
# Deliberately NOT using `set -e` here: this script's whole purpose is to
# detect and recover from a failure condition, so a failing health check
# must fall through to the restart logic below rather than aborting.

LOG_FILE="/var/log/optionix/nginx_monitor.log"
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}

# Check the master process is running
if ! systemctl is-active --quiet nginx; then
    log "ALERT: nginx is not active, attempting restart"
    systemctl restart nginx
    if systemctl is-active --quiet nginx; then
        log "RECOVERY: nginx restarted successfully"
    else
        log "CRITICAL: nginx failed to restart"
    fi
    exit 0
fi

# Check nginx actually answers on the health endpoint, not just that the
# process is technically running.
if ! curl -sf -o /dev/null --max-time 5 "http://127.0.0.1/health" 2>/dev/null \
    && ! curl -sfk -o /dev/null --max-time 5 "https://127.0.0.1/health" 2>/dev/null; then
    log "WARN: nginx process is active but /health did not respond, reloading config"
    systemctl reload nginx
fi

# Validate the current config is still syntactically correct (catches
# drift/corruption between deploys)
if ! nginx -t >/dev/null 2>&1; then
    log "CRITICAL: nginx configuration test failed - manual intervention required"
fi
