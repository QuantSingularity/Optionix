# Optionix Site Configuration - Financial Grade Security
# Generated by Ansible - DO NOT EDIT MANUALLY

# Redirect all HTTP traffic to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name {{ server_name }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ server_name }};

    ssl_certificate     /etc/letsencrypt/live/{{ server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ server_name }}/privkey.pem;

    client_max_body_size {{ nginx_client_max_body_size }};

    limit_conn conn_limit_per_ip 20;

    # Enforce the method/user-agent blocklists defined in
    # rate_limiting.conf.j2 - the maps that compute these variables are
    # inert on their own until something actually checks them.
    if ($blocked_method) {
        return 405;
    }
    if ($blocked_agent) {
        return 403;
    }

    # Static frontend build (see web-frontend/webpack.config.js output)
    root /var/www/optionix/dist;
    index index.html;

    # API requests are proxied straight through to the backend - it has
    # no /api prefix on its own routes (e.g. /auth/login, /trading/orders),
    # so nothing is stripped here.
    location /auth/ {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(trading|portfolio|analytics|risk|compliance|market)/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
        access_log off;
    }

    location = /metrics {
        # Metrics are for internal scraping only, not public traffic.
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_set_header Host $host;
    }

    # Single-page app fallback for client-side routing
    location / {
        limit_req zone=general burst=10 nodelay;
        try_files $uri $uri/ /index.html;
    }

    # Static assets: long cache, filenames are content-hashed by webpack
    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
