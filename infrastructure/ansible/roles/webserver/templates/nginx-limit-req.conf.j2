# Fail2ban filter for Nginx rate-limiting events
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Matches nginx error log lines produced when a request is rejected by
# limit_req (see the limit_req_zone definitions in nginx.conf.j2 and
# their application in optionix.conf.j2), e.g.:
#   2024/01/15 10:23:45 [error] 1234#0: *567 limiting requests,
#     excess: 20.500 by zone "api", client: 1.2.3.4, server: ...
#
# Referenced by the [nginx-limit-req] jail in jail.local.j2.

[Definition]
failregex = ^\s*\[error\]\s+\d+#\d+:\s+\*\d+\s+limiting requests, excess:.* by zone.*client: <HOST>
ignoreregex =
