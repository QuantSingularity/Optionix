# Logrotate Configuration for MySQL Logs - Financial Compliance
# Generated by Ansible - DO NOT EDIT MANUALLY

/var/log/mysql/*.log {
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    create 0640 mysql adm
    sharedscripts
    postrotate
        # Flush MySQL's own log handles rather than restarting the
        # service, so log rotation never causes a connection blip.
        test -x /usr/bin/mysqladmin || exit 0
        MYADMIN="/usr/bin/mysqladmin --defaults-file=/etc/mysql/debian.cnf"
        if [ -z "$(${MYADMIN} ping 2>/dev/null)" ]; then
            :
        else
            ${MYADMIN} flush-logs
        fi
    endscript
}

/var/log/mysql/mysql-slow.log {
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    create 0640 mysql adm
}
