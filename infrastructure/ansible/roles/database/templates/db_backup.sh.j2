#!/bin/bash
# Local database backup script - Financial Grade
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# Runs daily via cron (see roles/database/tasks/main.yml). This is a
# host-local backup, distinct from the centralized, encrypted,
# S3-uploaded backups that infrastructure/scripts/backup_recovery.sh
# performs from a separate operations host - this script provides a
# defense-in-depth local copy directly on the database server itself.

set -euo pipefail

BACKUP_DIR="/var/backups/optionix/mysql"
DB_NAME="{{ optionix_db_name }}"
RETENTION_DAYS=14
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
LOG_FILE="/var/log/optionix/db_backup.log"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

mkdir -p "$BACKUP_DIR"
mkdir -p "$(dirname "$LOG_FILE")"

log "Starting backup of database: $DB_NAME"

BACKUP_FILE="$BACKUP_DIR/${DB_NAME}_${TIMESTAMP}.sql.gz"

# Uses /root/.my.cnf (or /etc/mysql/debian.cnf) for credentials rather
# than passing --password on the command line, which would otherwise be
# visible to any local user via `ps`.
if mysqldump --single-transaction --quick --routines --triggers --events \
    "$DB_NAME" | gzip > "$BACKUP_FILE"; then
    log "Backup completed: $BACKUP_FILE ($(du -h "$BACKUP_FILE" | cut -f1))"
else
    log "ERROR: mysqldump failed for database $DB_NAME"
    rm -f "$BACKUP_FILE"
    exit 1
fi

# Remove backups older than the retention window
find "$BACKUP_DIR" -name "${DB_NAME}_*.sql.gz" -mtime "+${RETENTION_DAYS}" -delete

log "Backup rotation complete (retention: ${RETENTION_DAYS} days)"
