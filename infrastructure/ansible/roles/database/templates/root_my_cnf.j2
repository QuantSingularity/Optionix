# Root MySQL client credentials - Generated by Ansible - DO NOT EDIT MANUALLY
#
# Used by db_backup.sh and any other host-local automation that needs to
# run mysql/mysqldump/mysqladmin as root without putting the password on
# the command line (which would otherwise be visible to any local user
# via `ps`). Mode 0600, owned by root - see the task that deploys this
# file in roles/database/tasks/main.yml.

[client]
user = root
password = "{{ mysql_root_password }}"
socket = /var/run/mysqld/mysqld.sock
