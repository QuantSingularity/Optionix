# API Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000/ws

# Environment
NODE_ENV=development

# Feature Flags
REACT_APP_ENABLE_AI_FEATURES=true

# Analytics (Optional)
# REACT_APP_ANALYTICS_ID=

# Blockchain: no env vars needed here. The Wallet page connects directly to
# the browser's injected wallet (MetaMask, etc.) for signing, and reads
# on-chain state / prepares transactions through the backend's /blockchain
# endpoints - see code/backend/BLOCKCHAIN_INTEGRATION.md. Point
# REACT_APP_API_URL at a backend that has FUTURES_CONTRACT_ADDRESS /
# OPTIONS_CONTRACT_ADDRESS / ETHEREUM_PROVIDER_URL configured for this to do
# anything beyond wallet connection.
